---
import BaseLayout from "./BaseLayout.astro";
import { getAuthor } from "../data/authors";

interface Props {
    title: string;
    description: string;
    date: Date;
    author?: string;
    image?: { path: string };
    tags?: string[];
    filePath?: string;
}

const {
    title,
    description,
    date,
    author = "maxulysse",
    image,
    tags = [],
    filePath,
} = Astro.props as Props;

// Calculate read time
const WORDS_PER_MINUTE = 160;
const content = await Astro.slots.render("default");
const words = content.split(/\s+/).length;
const readTime = Math.ceil(words / WORDS_PER_MINUTE);

const authorInfo = getAuthor(author);

const githubBaseUrl = "https://github.com/maxulysse/maxulysse.github.io";
const editUrl = filePath
    ? `${githubBaseUrl}/edit/main/${filePath}`
    : githubBaseUrl;
---

<BaseLayout
    title={title}
    description={description}
    author={author}
    image={image}
    type="article"
>
    <div class="card-columns only-one-column">
        <div class="card rounded">
            <div class="card-header">
                <h1 class="card-title">{title}</h1>
                <h6 class="card-subtitle mb-2 text-muted">
                    <span
                        ><i class="fa-solid fa-user" aria-hidden="true"
                        ></i></span
                    >
                    <em>{authorInfo.name}</em>
                    <span
                        ><i class="fa-solid fa-calendar" aria-hidden="true"
                        ></i></span
                    >
                    {
                        date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "2-digit",
                            day: "2-digit",
                        })
                    }
                    <br />
                    <i class="fa-solid fa-clock" aria-hidden="true"></i>
                    {readTime} min read
                </h6>
            </div>
            <div class="card-body">
                <slot />

                {
                    tags && tags.length > 0 && (
                        <div class="tags mt-3">
                            {tags.map((tag) => (
                                <a
                                    href={`/tags#${tag.toLowerCase()}`}
                                    class="badge text-bg-primary"
                                >
                                    {tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
            <div class="card-footer">
                <small class="text-muted"
                    >This site is using <a
                        href="https://github.com/maxulysse/maxulysse.github.io"
                        target="_blank"
                        rel="noopener"><i class="fab fa-github"></i> GitHub</a
                    > for versioning. You can fix this page by suggesting changes
                    <a href={editUrl} target="_blank" rel="noopener">here.</a
                    ></small
                >
            </div>
        </div>
    </div>
</BaseLayout>

<style is:global>
    .card-columns {
        column-count: 1;
    }

    .tags a {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }
</style>
