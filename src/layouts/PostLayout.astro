---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { author } from "../data/authors";
import { formatDateIso } from "../lib/date";

interface Props {
    entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { title, description, date, image, tags } = entry.data;
const { Content } = await render(entry);

const WORDS_PER_MINUTE = 160;
const words = (entry.body ?? "").split(/\s+/).filter(Boolean).length;
const readTime = Math.ceil(words / WORDS_PER_MINUTE);

const githubBaseUrl = "https://github.com/maxulysse/maxulysse.github.io";
const editUrl = entry.filePath
    ? `${githubBaseUrl}/edit/main/${entry.filePath}`
    : githubBaseUrl;
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    type="article"
>
    <div class="card-columns only-one-column">
        <div class="card rounded">
            <div class="card-header">
                <h1 class="card-title">{title}</h1>
                <h6 class="card-subtitle mb-2 text-muted">
                    <span
                        ><i class="fa-solid fa-user" aria-hidden="true"
                        ></i></span
                    >
                    <em>{author.name}</em>
                    <span
                        ><i class="fa-solid fa-calendar" aria-hidden="true"
                        ></i></span
                    >
                    {formatDateIso(date)}
                    <br />
                    <i class="fa-solid fa-clock" aria-hidden="true"></i>
                    {readTime} min read
                </h6>
            </div>
            <div class="card-body">
                <Content />

                {
                    tags.length > 0 && (
                        <div class="tags mt-3">
                            {tags.map((tag) => (
                                <a
                                    href={`/tags#${tag.toLowerCase()}`}
                                    class="badge text-bg-primary"
                                >
                                    {tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>
            <div class="card-footer">
                <small class="text-muted"
                    >This site is using <a
                        href="https://github.com/maxulysse/maxulysse.github.io"
                        target="_blank"
                        rel="noopener"><i class="fab fa-github"></i> GitHub</a
                    > for versioning. You can fix this page by suggesting changes
                    <a href={editUrl} target="_blank" rel="noopener">here.</a
                    ></small
                >
            </div>
        </div>
    </div>
</BaseLayout>

<style is:global>
    .card-columns {
        column-count: 1;
    }

    .tags a {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }
</style>
