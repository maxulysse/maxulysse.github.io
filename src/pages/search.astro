---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPosts } from "../lib/posts";

const searchItems = (await getAllPosts()).map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description ?? "",
    date: post.data.date.toISOString().split("T")[0],
    tags: post.data.tags ?? [],
}));
---

<BaseLayout title="Search" description="Search blog posts.">
    <section class="py-3">
        <div class="card">
            <div class="card-header">
                <h1 class="h4 mb-0">Search</h1>
            </div>
            <div class="card-body">
                <form
                    action="/search"
                    method="get"
                    class="d-flex flex-wrap gap-2 mb-3"
                >
                    <input
                        id="search-input"
                        class="form-control flex-grow-1"
                        type="text"
                        name="q"
                        placeholder="Search posts, tags, or keywords"
                        aria-label="Search posts"
                        autocomplete="off"
                    />
                    <button class="btn btn-primary" type="submit">
                        <i
                            class="fa-solid fa-magnifying-glass"
                            aria-hidden="true"></i> Search
                    </button>
                </form>

                <p id="search-summary" class="text-muted mb-3"></p>
                <div id="search-results" class="list-group"></div>
                <div id="search-empty" class="d-none text-center py-3">
                    <p class="text-muted mb-3">No results found.</p>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a href="/tags" class="btn btn-outline-primary">
                            <i class="fa-solid fa-tags me-1" aria-hidden="true"></i>Browse tags
                        </a>
                        <a href="/archive" class="btn btn-outline-primary">
                            <i class="fa-regular fa-calendar me-1" aria-hidden="true"></i>Browse
                            archive
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script
        is:inline
        type="application/json"
        id="search-data"
        set:html={JSON.stringify(searchItems).replaceAll("<", "\\u003c")}
    />
    <script is:inline src="/js/search.js"></script>
</BaseLayout>
