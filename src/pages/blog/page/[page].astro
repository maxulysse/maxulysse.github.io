---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import { getAllPosts, POSTS_PER_PAGE } from "../../../lib/posts";

export const getStaticPaths = (async ({ paginate }) =>
    paginate(await getAllPosts(), { pageSize: POSTS_PER_PAGE })) satisfies GetStaticPaths;

interface Props {
    page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;

if (page.currentPage === 1) {
    return Astro.redirect("/");
}
---

<BaseLayout title={`Blog - Page ${page.currentPage}`} description="Blog posts">
    <h1 class="visually-hidden">Blog - Page {page.currentPage}</h1>
    <PostList posts={page.data} currentPage={page.currentPage} totalPages={page.lastPage} />
</BaseLayout>
