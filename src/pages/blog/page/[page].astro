---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPaginatedPosts, getTotalPages } from "../../../lib/pagination";

const page = parseInt((Astro.params.page as string) || "1");

if (page === 1) {
    return Astro.redirect("/");
}

const { posts, currentPage, totalPages } = await getPaginatedPosts(page);

export async function getStaticPaths() {
    const totalPages = await getTotalPages();
    return Array.from({ length: totalPages }, (_, i) => ({
        params: { page: String(i + 1) },
    }));
}
---

<BaseLayout title={`Blog - Page ${currentPage}`} description="Blog posts">
    <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination {currentPage} {totalPages} />
</BaseLayout>
