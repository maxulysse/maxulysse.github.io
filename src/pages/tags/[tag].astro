---
import { getTagIndex, itemsOfKind, formatDate, type TagEntry } from "../../lib/tags";
import BaseLayout from "../../layouts/BaseLayout.astro";

const tags = await getTagIndex();

export async function getStaticPaths() {
    const tags = await getTagIndex();
    return tags.map((entry) => ({
        params: { tag: entry.tag },
        props: { entry },
    }));
}

interface Props {
    entry: TagEntry;
}

const { tag } = Astro.params;
const { entry } = Astro.props;

const posts = itemsOfKind(entry, "post");
const projects = itemsOfKind(entry, "project");
---

<BaseLayout
    title={`Tags: ${tag}`}
    description={`Posts and projects tagged with ${tag}`}
>
    <h1>Tags</h1>

    <div class="tag-cloud">
        {
            tags.map((other) => (
                <a
                    href={`/tags/${other.tag}/`}
                    class={`badge ${other.tag === tag ? "text-bg-primary" : "text-bg-light"}`}
                >
                    {other.tag}
                </a>
            ))
        }
    </div>

    <div>
        {
            posts.length > 0 && (
                <div class="posts-for-tag">
                    <h2>Posts tagged with "{tag}"</h2>
                    <ul class="list-unstyled">
                        {posts.map((post) => (
                            <li class="post-item">
                                <a href={post.href}>{post.label}</a>
                                <small class="text-muted">
                                    {formatDate(post.date)}
                                </small>
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }

        {
            projects.length > 0 && (
                <div class="projects-for-tag">
                    <h2>Projects tagged with "{tag}"</h2>
                    <ul class="list-unstyled">
                        {projects.map((project) => (
                            <li class="project-item">
                                <a href={project.href}>{project.label}</a>
                                <small class="text-muted">
                                    <i
                                        class="fa-solid fa-diagram-project me-1"
                                        aria-hidden="true"
                                    />
                                    {project.years}
                                </small>
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }
    </div>
</BaseLayout>

<style>
    .tag-cloud {
        margin-bottom: 2rem;
    }

    .tag-cloud a {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .post-item,
    .project-item {
        margin-bottom: 1rem;
    }

    .post-item a,
    .project-item a {
        display: block;
        font-weight: 500;
    }
</style>
