---
import { getTagIndex, type TagEntry } from "../../lib/tags";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { tags } = await getTagIndex();

export async function getStaticPaths() {
    const { tags } = await getTagIndex();
    return tags.map((entry: TagEntry) => ({
        params: { tag: entry.tag },
        props: { entry },
    }));
}

interface Props {
    entry: TagEntry;
}

const { tag } = Astro.params;
const { entry } = Astro.props;
---

<BaseLayout
    title={`Tags: ${tag}`}
    description={`Posts and projects tagged with ${tag}`}
>
    <h1>Tags</h1>

    <div class="tag-cloud">
        {
            tags.map((other) => (
                <a
                    href={`/tags/${other.tag}/`}
                    class={`badge ${other.tag === tag ? "text-bg-primary" : "text-bg-light"}`}
                >
                    {other.tag}
                </a>
            ))
        }
    </div>

    {
        tag && (
            <div>
                {entry.posts.length > 0 && (
                    <div class="posts-for-tag">
                        <h2>Posts tagged with "{tag}"</h2>
                        <ul class="list-unstyled">
                            {entry.posts.map((post) => (
                                <li class="post-item">
                                    <a href={`/blog/${post.id}/`}>
                                        {post.data.title}
                                    </a>
                                    <small class="text-muted">
                                        {post.data.date.toLocaleDateString(
                                            "en-US",
                                            {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                            },
                                        )}
                                    </small>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}

                {entry.projects.length > 0 && (
                    <div class="projects-for-tag">
                        <h2>Projects tagged with "{tag}"</h2>
                        <ul class="list-unstyled">
                            {entry.projects.map((project) => (
                                <li class="project-item">
                                    <a href={`/projects/#${project.id}`}>
                                        {project.name}
                                    </a>
                                    <small class="text-muted">
                                        <i
                                            class="fa-solid fa-diagram-project me-1"
                                            aria-hidden="true"
                                        />
                                        {project.years}
                                    </small>
                                </li>
                            ))}
                        </ul>
                    </div>
                )}

                {entry.count === 0 && <p>Nothing found for this tag.</p>}
            </div>
        )
    }
</BaseLayout>

<style>
    .tag-cloud {
        margin-bottom: 2rem;
    }

    .tag-cloud a {
        margin-right: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .post-item,
    .project-item {
        margin-bottom: 1rem;
    }

    .post-item a,
    .project-item a {
        display: block;
        font-weight: 500;
    }
</style>
