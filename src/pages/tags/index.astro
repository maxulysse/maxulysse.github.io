---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagIndex } from "../../lib/tags";

const { tags } = await getTagIndex();

// Scale the tag cloud by the total number of items per tag.
const counts = tags.map((entry) => entry.count);
const minCount = Math.min(...counts);
const maxCount = Math.max(...counts);
const minSize = 0.9;
const maxSize = 1.8;

function getTagSize(count: number): number {
    if (maxCount === minCount) return (minSize + maxSize) / 2;
    return (
        minSize +
        ((count - minCount) / (maxCount - minCount)) * (maxSize - minSize)
    );
}
---

<BaseLayout
    title="Tags"
    description="Browse articles and projects by tag"
>
    <div class="card bg-light mb-4">
        <div class="card-body">
            <h6 class="card-text text-muted tag-cloud mb-0">
                {
                    tags.map((entry) => (
                        <a
                            href={`#${entry.tag}`}
                            class="tag-link"
                            style={`font-size: ${getTagSize(entry.count)}rem;`}
                        >
                            {entry.label}
                            <span class="badge text-bg-secondary badge-sm ms-1">
                                {entry.count}
                            </span>
                        </a>
                    ))
                }
            </h6>
        </div>
    </div>

    <div class="archive-grid">
        {
            tags.map((entry) => (
                <div id={entry.tag}>
                    <div class="card">
                        <div class="card-header">
                            <h3 class="mb-0">
                                <i
                                    class="fa-solid fa-tag me-2"
                                    aria-hidden="true"
                                />
                                {entry.label}
                                <span class="badge text-bg-secondary ms-2">
                                    {entry.count}
                                </span>
                            </h3>
                        </div>
                        <div class="card-body">
                            {entry.projects.length > 0 && (
                                <ul class="list-unstyled mb-0 mb-3">
                                    {entry.projects.map((project) => (
                                        <li class="mb-3">
                                            <small class="text-muted d-block">
                                                <i
                                                    class="fa-solid fa-diagram-project me-1"
                                                    aria-hidden="true"
                                                />
                                                {project.years}
                                            </small>
                                            <a href={`/projects/#${project.id}`}>
                                                {project.name}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                            <ul class="list-unstyled mb-0">
                                {entry.posts.map((post) => (
                                    <li class="mb-3">
                                        <small class="text-muted d-block">
                                            <i
                                                class="fa-regular fa-calendar me-1"
                                                aria-hidden="true"
                                            />
                                            {
                                                post.data.date
                                                    .toISOString()
                                                    .split("T")[0]
                                            }
                                        </small>
                                        <a href={`/blog/${post.id}/`}>
                                            {post.data.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</BaseLayout>

<style>
    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        justify-content: center;
        align-items: center;
        margin-bottom: 0;
    }

    .tag-link {
        text-decoration: none;
        color: #0d6efd;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
    }

    .tag-link:hover {
        background-color: #e7f1ff;
        color: #0a58ca;
        text-decoration: none;
    }

    .tag-link .badge {
        font-size: 0.6em;
    }

    .archive-grid {
        column-count: 3;
        column-gap: 1.5rem;
    }

    .archive-grid > div {
        break-inside: avoid;
        margin-bottom: 1.5rem;
    }

    @media (max-width: 991px) {
        .archive-grid {
            column-count: 2;
        }
    }

    @media (max-width: 767px) {
        .archive-grid {
            column-count: 1;
        }
    }
</style>
