---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getTagIndex, itemsOfKind } from "../../lib/tags";
import TagItemCard from "../../components/TagItemCard.astro";

const tags = await getTagIndex();

// Scale the tag cloud by the total number of items per tag.
const counts = tags.map((entry) => entry.items.length);
const minCount = Math.min(...counts);
const maxCount = Math.max(...counts);

// 0 for the rarest tag, 1 for the most used one; sqrt spreads out the many rare tags.
function getTagWeight(count: number): number {
    if (maxCount === minCount) return 0.5;
    return Math.sqrt((count - minCount) / (maxCount - minCount));
}

// Hash of the tag name, so the shuffle and rotations stay the same across builds.
function hashTag(tag: string): number {
    let h = 0;
    for (const c of tag) h = (Math.imul(h, 31) + c.charCodeAt(0)) >>> 0;
    return h;
}

// Size in rem; one tag in four reads bottom to top, the rest get a slight tilt.
function getTagVisual(entry: (typeof tags)[number]) {
    const w = getTagWeight(entry.items.length);
    const h = hashTag(entry.tag);
    return {
        size: (0.8 + w * 2).toFixed(2),
        weight: Math.round(3 + w * 4) * 100,
        opacity: (0.65 + w * 0.35).toFixed(2),
        rotate: h % 4 === 0 ? -90 : (h % 13) - 6,
    };
}

const cloudTags = [...tags]
    .sort((a, b) => hashTag(a.tag) - hashTag(b.tag))
    .map((entry) => ({ entry, visual: getTagVisual(entry) }));
---

<BaseLayout
    title="Tags"
    description="Browse articles and projects by tag"
>
    <h1 class="visually-hidden">Tags</h1>
    <div class="card bg-light mb-4">
        <div class="card-body">
            <h6 class="card-text text-muted tag-cloud mb-0">
                {
                    cloudTags.map(({ entry, visual }) => (
                        <a
                            href={`#${entry.tag}`}
                            class="tag-link"
                            style={`font-size: ${visual.size}rem; font-weight: ${visual.weight}; opacity: ${visual.opacity}`}
                            data-size={visual.size}
                            data-weight={visual.weight}
                            data-opacity={visual.opacity}
                            data-rotate={visual.rotate}
                            title={`${entry.items.length} ${entry.items.length === 1 ? "item" : "items"}`}
                        >
                            {entry.tag}
                        </a>
                    ))
                }
            </h6>
        </div>
    </div>

    <div class="archive-grid">
        {
            tags.map((entry) => {
                // Projects first, then posts.
                const items = [
                    ...itemsOfKind(entry, "project"),
                    ...itemsOfKind(entry, "post"),
                ];
                return (
                    <div id={entry.tag}>
                        <div class="card">
                            <div class="card-header">
                                <h3 class="mb-0">
                                    <i
                                        class="fa-solid fa-tag me-2"
                                        aria-hidden="true"
                                    />
                                    {entry.tag}
                                    <span class="badge text-bg-secondary ms-2">
                                        {entry.items.length}
                                    </span>
                                </h3>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0">
                                        {items.map((item) => (
                                            <TagItemCard {item} />
                                        ))}
                                    </ul>
                            </div>
                        </div>
                    </div>
                );
            })
        }
    </div>
</BaseLayout>

<script>
    import cloud from "d3-cloud";

    const SVG_NS = "http://www.w3.org/2000/svg";
    const SEED = 42;
    const PADDING = 3;
    // Words grow above this container width, up to MAX_SCALE.
    const SCALE_FROM_WIDTH = 700;
    const MAX_SCALE = 1.6;
    // First canvas is ASPECT * width tall, grown by GROWTH until every tag fits.
    const MIN_HEIGHT = 250;
    const ASPECT = 0.45;
    const GROWTH = 1.25;
    const MAX_TRIES = 5;

    type TagWord = cloud.Word & {
        text: string;
        size: number;
        rotate: number;
        href: string;
        title: string;
        weight: number;
        opacity: number;
    };

    const container = document.querySelector<HTMLElement>(".tag-cloud")!;
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    const font = getComputedStyle(container).fontFamily;
    const words: TagWord[] = [
        ...container.querySelectorAll<HTMLAnchorElement>(".tag-link"),
    ].map((a) => ({
        text: a.text.trim(),
        size: Number(a.dataset.size) * rem,
        rotate: Number(a.dataset.rotate),
        href: a.hash,
        title: a.title,
        weight: Number(a.dataset.weight),
        opacity: Number(a.dataset.opacity),
    }));

    // Seeded PRNG so the layout is the same on every visit.
    function seeded(seed: number): () => number {
        return () => {
            seed = (seed + 0x6d2b79f5) | 0;
            let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
    }

    // Crop the SVG to the placed words, offset by d3-cloud's centred origin.
    function render(width: number, height: number, placed: TagWord[], bounds: { x: number; y: number }[]) {
        const [min, max] = bounds;
        const w = max.x - min.x;
        const h = max.y - min.y;
        const svg = document.createElementNS(SVG_NS, "svg");
        svg.setAttribute("viewBox", `${min.x - width / 2} ${min.y - height / 2} ${w} ${h}`);
        svg.setAttribute("width", String(w));
        svg.setAttribute("height", String(h));
        svg.classList.add("tag-cloud-svg");
        for (const word of placed) {
            const a = document.createElementNS(SVG_NS, "a");
            a.setAttribute("href", word.href);
            const title = document.createElementNS(SVG_NS, "title");
            title.textContent = word.title;
            const text = document.createElementNS(SVG_NS, "text");
            text.setAttribute("text-anchor", "middle");
            text.setAttribute("transform", `translate(${word.x},${word.y}) rotate(${word.rotate})`);
            text.setAttribute("style", `font: ${word.weight} ${word.size}px ${font}; opacity: ${word.opacity}`);
            text.textContent = word.text;
            a.append(title, text);
            svg.append(a);
        }
        container.replaceChildren(svg);
    }

    // Only the latest layout may render: a resize stops the one still running.
    let current: ReturnType<typeof cloud<TagWord>> | undefined;

    // Grow the canvas until every tag fits; keep the plain list if it never does.
    function layout(width: number, height: number, scale: number, tries = 0) {
        current?.stop();
        current = cloud<TagWord>()
            .size([width, height])
            .words(words.map((w) => ({ ...w, size: w.size * scale })))
            .padding(PADDING)
            .rotate((w) => w.rotate)
            .font(font)
            .fontWeight((w) => w.weight)
            .fontSize((w) => w.size)
            .random(seeded(SEED))
            .on("end", (placed, bounds) => {
                if (placed.length === words.length) render(width, height, placed, bounds);
                else if (tries < MAX_TRIES) layout(width, Math.round(height * GROWTH), scale, tries + 1);
            })
            .start();
    }

    let laidOutWidth = 0;
    function relayout() {
        const width = container.clientWidth;
        if (width === laidOutWidth) return;
        laidOutWidth = width;
        const scale = Math.min(MAX_SCALE, Math.max(1, width / SCALE_FROM_WIDTH));
        layout(width, Math.max(MIN_HEIGHT, Math.round(width * ASPECT)), scale);
    }
    relayout();
    window.addEventListener("resize", relayout);
</script>

<style>
    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.1rem 0.6rem;
        justify-content: center;
        align-items: center;
        line-height: 1.1;
        margin-bottom: 0;
    }

    .tag-link {
        text-decoration: none;
        color: var(--accent-link);
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        transition: all 0.2s ease;
    }

    .tag-cloud :global(.tag-cloud-svg) {
        max-width: 100%;
        height: auto;
    }

    .tag-cloud :global(.tag-cloud-svg text) {
        fill: var(--accent-link);
        transition: fill 0.2s ease;
    }

    .tag-cloud :global(.tag-cloud-svg a:hover text),
    .tag-cloud :global(.tag-cloud-svg a:focus text) {
        fill: var(--accent-link-hover);
        opacity: 1 !important;
    }

    .tag-link:hover {
        opacity: 1 !important;
        background-color: color-mix(in srgb, var(--accent-link) 12%, transparent);
        color: var(--accent-link-hover);
        text-decoration: none;
    }
</style>
