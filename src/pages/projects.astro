---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetaFooter from "../components/MetaFooter.astro";
import { projects } from "../data/projects";
---

<BaseLayout
    title="Projects"
    description="Maxime Garcia, PhD in Bioinformatics"
>
    <h1 class="visually-hidden">Projects</h1>
    <div class="card-columns two-columns">
        {projects.map((project) => (
            <div class="card" id={project.id}>
                <div class="card-body">
                    {project.logo && (
                        <img
                            class:list={[
                                "project-logo",
                                project.logoDark && "logo-light",
                            ]}
                            src={project.logo}
                            alt=""
                            loading="lazy"
                        />
                    )}
                    {project.logoDark && (
                        <img
                            class="project-logo logo-dark"
                            src={project.logoDark}
                            alt=""
                            loading="lazy"
                        />
                    )}
                    <h5 class="card-title">
                        <a
                            href={project.url}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {project.name}
                        </a>
                        {project.github && (
                            <a
                                href={project.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-github ms-2"
                                aria-label={`${project.name} on GitHub`}
                            >
                                <i class="fab fa-github" aria-hidden="true" />
                            </a>
                        )}
                    </h5>
                    <h6 class="card-subtitle text-muted">
                        {project.role}
                    </h6>
                    <p class="card-text">{project.description}</p>
                </div>
                <MetaFooter date={project.years} tags={project.tags} />
            </div>
        ))}
    </div>
</BaseLayout>

<style>
    .card-body {
        display: flow-root;
    }

    .project-logo {
        float: right;
        height: 3rem;
        margin-left: 0.75rem;
    }

    .logo-dark,
    :global([data-bs-theme="dark"]) .logo-light {
        display: none;
    }

    :global([data-bs-theme="dark"]) .logo-dark {
        display: block;
    }
</style>
