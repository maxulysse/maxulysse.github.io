---
import BaseLayout from "../layouts/BaseLayout.astro";
import MetaFooter from "../components/MetaFooter.astro";
import { projects } from "../data/projects";
---

<BaseLayout
    title="Projects"
    description="Maxime Garcia, PhD in Bioinformatics"
>
    <div class="card-columns only-one-column">
        {projects.map((project) => (
            <div class="card" id={project.id}>
                <div class="card-body">
                    <h5 class="card-title">
                        <a
                            href={project.url}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {project.name}
                        </a>
                        {project.github && (
                            <a
                                href={project.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-github ms-2"
                                aria-label={`${project.name} on GitHub`}
                            >
                                <i class="fab fa-github" aria-hidden="true" />
                            </a>
                        )}
                    </h5>
                    <h6 class="card-subtitle text-muted">
                        {project.role}
                    </h6>
                    <p class="card-text">{project.description}</p>
                </div>
                <MetaFooter date={project.years} tags={project.tags} />
            </div>
        ))}
    </div>
</BaseLayout>
