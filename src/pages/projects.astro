---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionCard from "../components/SectionCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
    title="Projects"
    description="Maxime Garcia, PhD in Bioinformatics"
>
    <div class="card-columns only-one-column">
        <div class="card">
            <SectionCard
                id="projects"
                icon="fa-solid fa-flask"
                title="Projects"
            />
        </div>
        {projects.map((project) => (
            <div class="card" id={project.id}>
                <div class="card-body">
                    <h5 class="card-title">
                        {project.url ? (
                            <a
                                href={project.url}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                {project.name}
                            </a>
                        ) : (
                            project.name
                        )}
                        {project.github && (
                            <a
                                href={project.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="project-github ms-2"
                                aria-label={`${project.name} on GitHub`}
                            >
                                <i class="fab fa-github" aria-hidden="true" />
                            </a>
                        )}
                    </h5>
                    <h6 class="card-subtitle text-muted">
                        {project.role}
                    </h6>
                    <p class="card-text">{project.description}</p>
                </div>
                <div class="card-footer">
                    <small class="text-muted d-block mb-2">
                        <i class="fa-regular fa-calendar me-1" aria-hidden="true" />
                        {project.years}
                    </small>
                    <div class="tags-container">
                        <span class="text-muted me-2">
                            <i class="fa-solid fa-tags" aria-hidden="true" />
                        </span>
                        {project.tags.map((tag: string, index: number) => (
                            <>
                                <a
                                    href={`/tags/${tag.toLowerCase()}/`}
                                    class="tag-badge"
                                >
                                    {tag}
                                </a>
                                {index < project.tags.length - 1 && (
                                    <span class="tag-separator">•</span>
                                )}
                            </>
                        ))}
                    </div>
                </div>
            </div>
        ))}
    </div>
</BaseLayout>

<style>
    .project-github {
        color: var(--text-muted);
        font-size: 0.9em;
    }

    .project-github:hover {
        color: var(--accent-link-hover);
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem;
    }
</style>
