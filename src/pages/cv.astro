---
import BaseLayout from "../layouts/BaseLayout.astro";
import CvSection from "../components/CvSection.astro";
import { cvSections } from "../data/cv";
import {
    publicationSections,
    publicationsBySection,
} from "../lib/publications";
---

<BaseLayout title="CV" description="Maxime Garcia, PhD in Bioinformatics">
    <div class="card-columns only-one-column cv-page">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-text text-muted cv-toc">
                    <a href="#experience">Experience</a> •
                    <a href="#education">Education</a> •
                    <a href="#skills">Computer skills</a> •
                    <a href="#publications">Publications</a> •
                    <a href="#languages">Languages</a> •
                    <a href="#societies">Scientific societies</a> •
                    <a href="#associations">Associations</a> •
                    <a href="#events">Organization and events</a> •
                    <a href="#interests">Interests</a>
                </h6>
            </div>
        </div>

        <div class="card alert alert-primary">
            <h6 class="card-text text-muted">
                <i class="fa-solid fa-download"></i>
                <a
                    href="https://raw.githubusercontent.com/maxulysse/maxulysse.github.io/cv/CV-MGarcia-latest.pdf"
                    target="_blank"
                    rel="noopener noreferrer">Download a PDF version</a
                >
            </h6>
        </div>

        {cvSections.map((section) => (
            <CvSection id={section.id} icon={section.icon} title={section.title}>
                {section.kind === "table" && (
                    <table class="cv-table">
                        <tbody>
                            {section.items.map((item) => (
                                <tr>
                                    <td class="cv-date">
                                        <i class="fa-solid fa-calendar"></i> {item.date}
                                    </td>
                                    <td set:html={item.content} />
                                </tr>
                            ))}
                        </tbody>
                    </table>
                )}

                {section.kind === "grid" && section.items.map((row, rowIndex) => (
                    <>
                        {rowIndex > 0 && <hr />}
                        <div
                            class="row cv-skills"
                            style={section.columns ? `grid-template-columns: repeat(${section.columns}, 1fr)` : undefined}
                        >
                            {row.map((item) => (
                                <div class="cv-item">
                                    <span class="cv-item-label">{item.label}</span>
                                    <span class="cv-item-value">{item.value}</span>
                                </div>
                            ))}
                        </div>
                    </>
                ))}

                {section.kind === "list" && section.items.map((item, index) => (
                    <>
                        <div class="cv-full-item" set:html={item.content} />
                        {index < section.items.length - 1 && <hr class="cv-divider" />}
                    </>
                ))}
            </CvSection>
        ))}

        <CvSection id="publications" icon="fa-solid fa-book" title="Publications">
            {
                publicationSections.map((section) => {
                    const sectionPublications =
                        publicationsBySection[section.id] ?? [];
                    if (sectionPublications.length === 0) return null;

                    return (
                        <div class="publication-section">
                            <h5 class="publication-section-title">
                                <i class={section.icon} /> {section.label}
                            </h5>
                            <ul class="publications-list mb-0">
                                {sectionPublications.map((publication) => (
                                    <li id={publication.id}>
                                        {publication.authors && (
                                            <>{publication.authors}, </>
                                        )}
                                        <em>{publication.title}</em>
                                        {(publication.venue ||
                                            publication.date) &&
                                            ", "}
                                        {publication.venue}
                                        {publication.venue &&
                                            publication.date &&
                                            ", "}
                                        {publication.date}.
                                        {publication.links.length > 0 && (
                                            <span class="publication-links">
                                                {publication.links.map(
                                                    (link) => (
                                                        <a
                                                            href={link.href}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            aria-label={
                                                                link.label
                                                            }
                                                            title={
                                                                link.label
                                                            }
                                                        >
                                                            {link.text ? (
                                                                link.text
                                                            ) : (
                                                                <i
                                                                    class={
                                                                        link.iconClass
                                                                    }
                                                                />
                                                            )}
                                                        </a>
                                                    ),
                                                )}
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    );
                })
            }
        </CvSection>

        <CvSection id="interests" icon="fa-solid fa-info-circle" title="Interests">
            <div class="row">
                <div class="col">
                    • Yoga, Cinema, Poker, Gardening, Ice-Skating
                </div>
            </div>
        </CvSection>
    </div>
</BaseLayout>

<style>
    .cv-toc {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
    }

    .list-group-item {
        border: none;
        padding: 0.5rem 0;
    }

    .cv-table {
        width: 100%;
        border-collapse: collapse;
    }

    .cv-table td {
        padding: 0.5rem 0;
        vertical-align: top;
    }

    .cv-table tr + tr td {
        border-top: 1px solid #e5e5e5;
    }

    .cv-date {
        width: 20%;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .cv-table td {
            display: block;
            width: 100%;
        }

        .cv-table tr + tr td {
            border-top: none;
        }

        .cv-date {
            margin-bottom: 0.5rem;
        }
    }

    body[data-theme="dark"] .cv-table tr + tr td {
        border-top-color: #444;
    }

    .cv-divider {
        margin: 1rem 0;
    }

    .cv-page .row {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 0 !important;
    }

    .cv-page .col-md-2 {
        flex: 0 0 16.6667%;
        max-width: 16.6667%;
    }

    .cv-page .col-md-4 {
        flex: 0 0 33.3333%;
        max-width: 33.3333%;
    }

    .cv-page .col {
        flex: 1 0 0;
        max-width: 100%;
    }

    .cv-page .cv-skills {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        grid-auto-flow: row !important;
        gap: 0.5rem 1rem !important;
    }

    .cv-page .cv-languages {
        display: grid !important;
        grid-template-columns: repeat(3, 1fr) !important;
        grid-auto-flow: row !important;
        gap: 0.5rem 1rem !important;
    }

    .cv-item {
        display: grid;
        grid-template-columns: 13rem 1fr;
        column-gap: 0.5rem;
        align-items: baseline;
    }

    .cv-item-label {
        white-space: nowrap;
    }

    .cv-item-label::before {
        content: "• ";
    }

    .card-body .row + hr {
        margin: 1rem 0;
    }

    .publication-section {
        margin-bottom: 1.5rem;
    }

    .publication-section:last-child {
        margin-bottom: 0;
    }

    .publication-section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .publications-list {
        margin: 0;
        padding-left: 1.25rem;
    }

    .publications-list li {
        padding: 0.5rem 0;
    }

    .publications-list li + li {
        border-top: 1px solid #e5e5e5;
    }

    body[data-theme="dark"] .publications-list li + li {
        border-top-color: #444;
    }

    .publication-links {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-left: 0.5rem;
    }

    .publication-links a {
        text-decoration: none;
    }
</style>
