{
  "name": "maxulysse.github.io",
  "version": "1.0.0",
  "description": "Interested in Bioinformatics, Reproducible Research, Automation, Data Integration and Visualization...",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "npm run lint:eslint && npm run check",
    "lint:eslint": "eslint src --ext .ts,.astro",
    "format": "prettier --write \"src/**/*.{ts,astro}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro}\"",
    "prek": "prek run"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/eslintrc": "^3.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "yaml": "^2.8.3"
  }
}
